From 80513cc4593b3c138ebd267ac0f8a8d91ebaf178 Mon Sep 17 00:00:00 2001
From: "Jarod Lee (MacMini)" <lee.jarod@gmail.com>
Date: Mon, 2 Nov 2026 13:36:12 +0800
Subject: [PATCH] Input: apple_z2: recover sustained J71b control-only stalls

---
 ...-Recover-control-only-runtime-stalls.patch | 250 ++++++++++++++++++
 tests/test_z2_control_stall.py                | 184 +++++++++++++
 2 files changed, 434 insertions(+)
 create mode 100644 kernel/patches/drivers/input/0015-Input-apple_z2-Recover-control-only-runtime-stalls.patch
 create mode 100644 tests/test_z2_control_stall.py

diff --git a/kernel/patches/drivers/input/0015-Input-apple_z2-Recover-control-only-runtime-stalls.patch b/kernel/patches/drivers/input/0015-Input-apple_z2-Recover-control-only-runtime-stalls.patch
new file mode 100644
index 00000000..25212504
--- /dev/null
+++ b/kernel/patches/drivers/input/0015-Input-apple_z2-Recover-control-only-runtime-stalls.patch
@@ -0,0 +1,250 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Jarod Lee <lee.jarod@gmail.com>
+Date: Mon, 2 Nov 2026 10:52:12 +0800
+Subject: [PATCH] Input: apple_z2: recover sustained control-only runtime
+ stalls
+
+A J71b controller can continue raising interrupts and replying with control
+frames without ever delivering another touch report. SPI calls still
+succeed, so the runtime drain loop otherwise never recovers.
+
+Detect only a sustained, bounded run of control-only replies after report
+initialization. Mask the runtime IRQ, release stale contacts, and reboot
+the controller from work context with bounded retries. Normal idle, empty
+queues, transient or sparse control replies and valid reports do not
+trigger recovery.
+
+Opt in through J71b match data. Keep other generations on their existing
+paths and cancel recovery before stopping or removing the device.
+
+Signed-off-by: Jarod Lee <lee.jarod@gmail.com>
+---
+ drivers/input/touchscreen/apple_z2.c | 119 ++++++++++++++++++++++++++-
+ 1 file changed, 117 insertions(+), 2 deletions(-)
+
+diff --git a/drivers/input/touchscreen/apple_z2.c b/drivers/input/touchscreen/apple_z2.c
+index 19d9f36..035b80a 100644
+--- a/drivers/input/touchscreen/apple_z2.c
++++ b/drivers/input/touchscreen/apple_z2.c
+@@ -56,6 +56,12 @@
+ #define APPLE_Z2_CMD_CTRL_READ_LONG      0xE7
+ #define APPLE_Z2_CMD_LAST                0xE1
+ #define APPLE_Z2_CMD_WAKE                0xEE
++/* A bounded run of control replies is not normal input inactivity. */
++#define APPLE_Z2_CONTROL_STALL_MS        2000
++#define APPLE_Z2_CONTROL_STALL_READS     64
++#define APPLE_Z2_CONTROL_GAP_MS          250
++#define APPLE_Z2_CONTROL_RESTARTS        3
++#define APPLE_Z2_CONTROL_RETRY_MS        1000
+ #define APPLE_Z2_CMD_SIZE                16
+ #define APPLE_Z2_RAW_XFER_MAX_SIZE       64
+ #define APPLE_Z2_GEN2_MIN_RESULT_SIZE    64
+@@ -195,6 +201,7 @@ struct apple_z2_n1_info {
+  * @cs_hold_us:		generation-1 chip-select hold delay
+  * @cs_inactive_us:	generation-1 chip-select inactive delay
+  * @n1:			N1 bootloader and runtime parameters
++ * @recover_control_stall: restart after a sustained control-only runtime loop
+  */
+ struct apple_z2_chip_info {
+ 	const char *name;
+@@ -203,6 +210,7 @@ struct apple_z2_chip_info {
+ 	unsigned int cs_hold_us;
+ 	unsigned int cs_inactive_us;
+ 	const struct apple_z2_n1_info *n1;
++	bool recover_control_stall;
+ };
+ 
+ struct apple_z2 {
+@@ -224,6 +232,10 @@ struct apple_z2 {
+ 	struct gpio_desc *attn_gpio;
+ 	struct delayed_work rearm_work;
+ 	unsigned int rearm_attempts;
++	unsigned int control_reads;
++	unsigned long control_since;
++	unsigned long control_last;
++	bool recovering;
+ 	unsigned long last_wake;
+ 	bool wake_valid;
+ 	bool ana_enabled;
+@@ -371,6 +383,7 @@ static int apple_z2_hbpp_xfer(struct apple_z2 *z2, unsigned int len);
+ static int apple_z2_hbpp_nop(struct apple_z2 *z2);
+ static void apple_z2_platform_power_off(struct apple_z2 *z2);
+ static int apple_z2_j71t_boot(struct apple_z2 *z2);
++static int apple_z2_boot(struct apple_z2 *z2);
+ 
+ static bool apple_z2_float_to_integer(const u8 *raw, s64 *value)
+ {
+@@ -994,6 +1007,7 @@ static void apple_z2_reset_protocol(struct apple_z2 *z2)
+ 	z2->index_parity = 0;
+ 	z2->runtime_frame_valid = false;
+ 	z2->surface_descriptor_valid = false;
++	z2->control_reads = 0;
+ }
+ 
+ static int apple_z2_advance_protocol(struct apple_z2 *z2,
+@@ -1849,6 +1863,34 @@ static int apple_z2_j172_init_writes_locked(struct apple_z2 *z2)
+ 					 APPLE_Z2_STATE_REPORTS_READY);
+ }
+ 
++/* io_lock is held. Empty queues and valid frames always clear the run. */
++static bool apple_z2_control_stalled(struct apple_z2 *z2)
++{
++	if (!z2->info->recover_control_stall ||
++	    z2->protocol_state != APPLE_Z2_STATE_REPORTS_READY)
++		return false;
++
++	if (!z2->runtime_control_reply || z2->runtime_frame_valid ||
++	    z2->runtime_queue_empty) {
++		z2->control_reads = 0;
++		return false;
++	}
++
++	if (!z2->control_reads ||
++	    time_after(jiffies, z2->control_last +
++		       msecs_to_jiffies(APPLE_Z2_CONTROL_GAP_MS))) {
++		z2->control_reads = 0;
++		z2->control_since = jiffies;
++	}
++	z2->control_last = jiffies;
++	if (z2->control_reads < APPLE_Z2_CONTROL_STALL_READS)
++		z2->control_reads++;
++
++	return z2->control_reads == APPLE_Z2_CONTROL_STALL_READS &&
++	       time_after_eq(jiffies, z2->control_since +
++			     msecs_to_jiffies(APPLE_Z2_CONTROL_STALL_MS));
++}
++
+ /*
+  * Generation-1 controllers raise a level interrupt while reports are
+  * queued. Service it by reading (and so acknowledging) up to four reports.
+@@ -1862,6 +1904,8 @@ static int apple_z2_gen1_drain(struct apple_z2 *z2)
+ 		error = apple_z2_read_packet(z2);
+ 		if (error)
+ 			return error;
++		if (apple_z2_control_stalled(z2))
++			return -ETIMEDOUT;
+ 		if (z2->runtime_queue_empty ||
+ 		    (!z2->runtime_frame_valid && !z2->runtime_control_reply))
+ 			break;
+@@ -2070,6 +2114,67 @@ static void apple_z2_n1_irq_locked(struct apple_z2 *z2)
+ 			      msecs_to_jiffies(APPLE_Z2_N1_REARM_DELAY_MS));
+ }
+ 
++/*
++ * Restart outside the IRQ thread and io_lock: boot waits for boot IRQs and
++ * takes io_lock itself. Removal/suspend marks stopping before cancelling us.
++ */
++static void apple_z2_control_rearm_work(struct work_struct *work)
++{
++	struct apple_z2 *z2 = container_of(to_delayed_work(work),
++					   struct apple_z2, rearm_work);
++	bool retry;
++	int error;
++
++	mutex_lock(&z2->io_lock);
++	if (z2->stopping || !z2->recovering) {
++		mutex_unlock(&z2->io_lock);
++		return;
++	}
++	z2->booted = false;
++	z2->rearm_attempts++;
++	mutex_unlock(&z2->io_lock);
++
++	/* The handler which scheduled us must finish before changing power. */
++	synchronize_irq(z2->spidev->irq);
++	gpiod_direction_output(z2->reset_gpio, 1);
++	apple_z2_platform_power_off(z2);
++	error = apple_z2_boot(z2);
++
++	mutex_lock(&z2->io_lock);
++	retry = error && !z2->stopping &&
++		z2->rearm_attempts < APPLE_Z2_CONTROL_RESTARTS;
++	if (!retry)
++		z2->recovering = false;
++	if (retry)
++		schedule_delayed_work(&z2->rearm_work,
++				      msecs_to_jiffies(APPLE_Z2_CONTROL_RETRY_MS));
++	mutex_unlock(&z2->io_lock);
++
++	if (error)
++		dev_err(&z2->spidev->dev,
++			"touch control-stall restart %u failed: %d\n",
++			z2->rearm_attempts, error);
++	else
++		dev_info(&z2->spidev->dev,
++			 "touch recovered from control-only stall\n");
++}
++
++/* io_lock is held; queue at most one restart for this stalled run. */
++static void apple_z2_queue_control_recovery(struct apple_z2 *z2)
++{
++	if (z2->recovering || z2->stopping)
++		return;
++
++	dev_warn_ratelimited(&z2->spidev->dev,
++			     "control-only touch stall, restarting\n");
++	apple_z2_release_contacts(z2);
++	z2->irq_on = false;
++	disable_irq_nosync(z2->spidev->irq);
++	z2->recovering = true;
++	z2->rearm_attempts = 0;
++	schedule_delayed_work(&z2->rearm_work, 0);
++}
++
+ static irqreturn_t apple_z2_irq(int irq, void *data)
+ {
+ 	struct apple_z2 *z2 = data;
+@@ -2083,8 +2188,15 @@ static irqreturn_t apple_z2_irq(int irq, void *data)
+ 		mutex_unlock(&z2->io_lock);
+ 	} else {
+ 		mutex_lock(&z2->io_lock);
++		if (z2->info->recover_control_stall &&
++		    (z2->stopping || !z2->irq_on)) {
++			mutex_unlock(&z2->io_lock);
++			return IRQ_HANDLED;
++		}
+ 		error = apple_z2_is_gen1(z2) ? apple_z2_gen1_drain(z2) :
+ 						 apple_z2_read_packet(z2);
++		if (error == -ETIMEDOUT && z2->info->recover_control_stall)
++			apple_z2_queue_control_recovery(z2);
+ 		mutex_unlock(&z2->io_lock);
+ 		if (error)
+ 			dev_warn_ratelimited(&z2->spidev->dev,
+@@ -3938,6 +4050,7 @@ static const struct apple_z2_chip_info apple_z2_j71b_info = {
+ 	.variant = APPLE_Z2_VARIANT_J71B,
+ 	.cs_setup_us = 1000,
+ 	.cs_inactive_us = 1000,
++	.recover_control_stall = true,
+ };
+ 
+ /*
+@@ -4106,7 +4219,8 @@ static int apple_z2_probe(struct spi_device *spi)
+ 						    "apple,z2-no-init-ack");
+ 	init_completion(&z2->boot_irq);
+ 	mutex_init(&z2->io_lock);
+-	INIT_DELAYED_WORK(&z2->rearm_work, apple_z2_n1_rearm_work);
++	INIT_DELAYED_WORK(&z2->rearm_work, info->recover_control_stall ?
++			  apple_z2_control_rearm_work : apple_z2_n1_rearm_work);
+ 	spi_set_drvdata(spi, z2);
+ 
+ 	z2->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+@@ -4294,7 +4408,7 @@ static void apple_z2_stop(struct apple_z2 *z2)
+ {
+ 	bool irq_on;
+ 
+-	if (apple_z2_is_j71t(z2)) {
++	if (apple_z2_is_j71t(z2) || z2->info->recover_control_stall) {
+ 		mutex_lock(&z2->io_lock);
+ 		z2->stopping = true;
+ 		mutex_unlock(&z2->io_lock);
+@@ -4331,6 +4445,7 @@ static int apple_z2_resume(struct device *dev)
+ 	struct apple_z2 *z2 = spi_get_drvdata(to_spi_device(dev));
+ 
+ 	z2->stopping = false;
++	z2->recovering = false;
+ 	return apple_z2_boot(z2);
+ }
+ 
+-- 
+2.54.0 (Apple Git-157)
+
diff --git a/tests/test_z2_control_stall.py b/tests/test_z2_control_stall.py
new file mode 100644
index 00000000..6c218b1d
--- /dev/null
+++ b/tests/test_z2_control_stall.py
@@ -0,0 +1,184 @@
+"""Execute the driver's control-stall and recovery paths with synthetic input."""
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+PATCH = ROOT / 'kernel/patches/drivers/input/0015-Input-apple_z2-Recover-control-only-runtime-stalls.patch'
+
+
+def postimage():
+    lines = []
+    for line in PATCH.read_text().splitlines():
+        if line[:1] in ('+', ' ') and not line.startswith('+++'):
+            lines.append(line[1:])
+    return '\n'.join(lines)
+
+
+def function(source, name):
+    start = source.index('static ' + name)
+    opening = source.index('{', start)
+    depth = 0
+    for end in range(opening, len(source)):
+        depth += source[end] == '{'
+        depth -= source[end] == '}'
+        if not depth:
+            return source[start:end + 1]
+    raise ValueError(name)
+
+
+class ControlStall(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cc = shutil.which('cc') or shutil.which('clang')
+        if cc is None:
+            raise unittest.SkipTest('A C compiler is required')
+        cls.temp = tempfile.TemporaryDirectory()
+        cls.addClassCleanup(cls.temp.cleanup)
+        root = Path(cls.temp.name)
+        src = postimage()
+        constants = '\n'.join(re.findall(r'^#define APPLE_Z2_CONTROL_.*$', src, re.M))
+        definitions = '\n'.join(function(src, name) for name in (
+            'bool apple_z2_control_stalled(',
+            'void apple_z2_control_rearm_work(',
+            'void apple_z2_queue_control_recovery(',
+        ))
+        program = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <limits.h>
+#include <string.h>
+#define APPLE_Z2_STATE_REPORTS_READY 7
+#define msecs_to_jiffies(x) ((unsigned long)(x))
+#define time_after(a,b) ((long)((unsigned long)(a)-(unsigned long)(b))>0)
+#define time_after_eq(a,b) ((long)((unsigned long)(a)-(unsigned long)(b))>=0)
+#define container_of(p,t,m) ((t *)((char *)(p)-offsetof(t,m)))
+#define to_delayed_work(p) container_of(p,struct delayed_work,work)
+#define dev_err(...) ((void)0)
+#define dev_info(...) ((void)0)
+#define dev_warn_ratelimited(...) ((void)0)
+struct work_struct { int unused; };
+struct delayed_work { struct work_struct work; };
+struct spi_device { int irq; int dev; };
+struct apple_z2_chip_info { bool recover_control_stall; };
+struct apple_z2 {
+    const struct apple_z2_chip_info *info;
+    bool runtime_control_reply, runtime_frame_valid, runtime_queue_empty;
+    unsigned control_reads, rearm_attempts;
+    unsigned long control_since, control_last;
+    int protocol_state, io_lock;
+    bool stopping, recovering, booted, irq_on;
+    struct spi_device *spidev;
+    struct delayed_work rearm_work;
+    void *reset_gpio;
+};
+static unsigned long jiffies, queued_delay;
+static unsigned queued, masked, released, synchronised, powered_off, boots;
+static int boot_error;
+static struct apple_z2 *current;
+static void mutex_lock(int *l) { assert(*l==0); *l=1; }
+static void mutex_unlock(int *l) { assert(*l==1); *l=0; }
+static void synchronize_irq(int irq) { (void)irq; assert(!current->io_lock); synchronised++; }
+static void gpiod_direction_output(void *gpio, int value) {
+    (void)gpio; assert(value==1 && synchronised>powered_off && !current->io_lock);
+}
+static void apple_z2_platform_power_off(struct apple_z2 *z) {
+    assert(z==current && !z->io_lock); powered_off++;
+}
+static int apple_z2_boot(struct apple_z2 *z) {
+    assert(!z->io_lock && !z->booted); boots++; z->booted=!boot_error;
+    return boot_error;
+}
+static void schedule_delayed_work(struct delayed_work *w, unsigned long delay) {
+    assert(w==&current->rearm_work && current->io_lock); queued++; queued_delay=delay;
+}
+static void disable_irq_nosync(int irq) { (void)irq; assert(current->io_lock); masked++; }
+static void apple_z2_release_contacts(struct apple_z2 *z) { assert(z->io_lock); released++; }
+'''
+        program += constants + '\n' + definitions
+        program += r'''
+static void sample(struct apple_z2 *z, unsigned long now) { jiffies=now; }
+int main(int argc, char **argv) {
+    const struct apple_z2_chip_info supported={true}, other={false};
+    struct spi_device spi={.irq=78};
+    struct apple_z2 z={.info=&supported,.protocol_state=APPLE_Z2_STATE_REPORTS_READY,
+        .booted=true,.irq_on=true,.runtime_control_reply=true,.spidev=&spi};
+    unsigned i;
+    assert(argc==2); current=&z;
+    if(!strcmp(argv[1],"stall")) {
+        for(i=0;i<200;i++) { sample(&z,i*10); assert(!apple_z2_control_stalled(&z)); }
+        sample(&z,1999); assert(!apple_z2_control_stalled(&z));
+        sample(&z,2000); assert(apple_z2_control_stalled(&z));
+        assert(z.control_reads==APPLE_Z2_CONTROL_STALL_READS);
+    } else if(!strcmp(argv[1],"idle")) {
+        z.runtime_control_reply=false;
+        for(i=0;i<1000;i++) { sample(&z,i*10000UL); assert(!apple_z2_control_stalled(&z)); }
+        assert(!z.control_reads);
+        z.runtime_control_reply=true; z.runtime_queue_empty=true;
+        for(i=0;i<1000;i++) { sample(&z,i*10000UL); assert(!apple_z2_control_stalled(&z)); }
+        assert(!z.control_reads);
+    } else if(!strcmp(argv[1],"sparse")) {
+        for(i=0;i<1000;i++) { sample(&z,i*1000UL); assert(!apple_z2_control_stalled(&z)); }
+        assert(z.control_reads==1);
+    } else if(!strcmp(argv[1],"normal")) {
+        for(i=0;i<1000;i++) {
+            z.runtime_frame_valid=(i%16==0);
+            sample(&z,i*20UL); assert(!apple_z2_control_stalled(&z));
+        }
+        z.control_reads=64; z.runtime_frame_valid=false; z.runtime_control_reply=false;
+        assert(!apple_z2_control_stalled(&z) && !z.control_reads);
+    } else if(!strcmp(argv[1],"scope")) {
+        z.info=&other;
+        for(i=0;i<1000;i++) { sample(&z,i*1000UL); assert(!apple_z2_control_stalled(&z)); }
+        z.info=&supported; z.protocol_state=0;
+        for(i=0;i<1000;i++) { sample(&z,i*1000UL); assert(!apple_z2_control_stalled(&z)); }
+        assert(!z.control_reads);
+    } else if(!strcmp(argv[1],"wrap")) {
+        for(i=0;i<200;i++) { sample(&z,ULONG_MAX-999+i*10); assert(!apple_z2_control_stalled(&z)); }
+        sample(&z,999); assert(!apple_z2_control_stalled(&z));
+        sample(&z,1000); assert(apple_z2_control_stalled(&z));
+    } else if(!strcmp(argv[1],"queue")) {
+        mutex_lock(&z.io_lock);
+        for(i=0;i<100;i++) apple_z2_queue_control_recovery(&z);
+        mutex_unlock(&z.io_lock);
+        assert(queued==1 && masked==1 && released==1 && z.recovering && !z.irq_on);
+        assert(queued_delay==0);
+        apple_z2_control_rearm_work(&z.rearm_work.work);
+        assert(boots==1 && synchronised==1 && powered_off==1 && !z.recovering);
+    } else if(!strcmp(argv[1],"stopped")) {
+        z.stopping=true; z.recovering=true;
+        mutex_lock(&z.io_lock); apple_z2_queue_control_recovery(&z); mutex_unlock(&z.io_lock);
+        apple_z2_control_rearm_work(&z.rearm_work.work);
+        assert(!boots && !queued && !masked && !released && !powered_off);
+    } else if(!strcmp(argv[1],"bounded")) {
+        z.recovering=true; boot_error=-5;
+        for(i=0;i<3;i++) apple_z2_control_rearm_work(&z.rearm_work.work);
+        assert(boots==3 && queued==2 && !z.recovering && queued_delay==1000);
+        apple_z2_control_rearm_work(&z.rearm_work.work);
+        assert(boots==3 && queued==2);
+    } else { assert(0); }
+    return 0;
+}
+'''
+        (root / 'test.c').write_text(program)
+        cls.exe = root / 'test'
+        subprocess.run([cc, '-std=c11', '-Wall', '-Wextra', '-Werror', '-Wno-unused-parameter',
+                        str(root / 'test.c'), '-o', str(cls.exe)], check=True, capture_output=True)
+
+    def run_case(self, name):
+        subprocess.run([str(self.exe), name], check=True, timeout=10)
+
+    def test_sustained_control_loop_requires_both_duration_and_count(self): self.run_case('stall')
+    def test_idle_and_empty_queues_do_not_restart(self): self.run_case('idle')
+    def test_sparse_control_replies_do_not_accumulate_across_idle(self): self.run_case('sparse')
+    def test_valid_frames_and_transient_controls_clear_the_run(self): self.run_case('normal')
+    def test_other_devices_and_boot_initialization_are_unchanged(self): self.run_case('scope')
+    def test_jiffies_wrap_is_handled(self): self.run_case('wrap')
+    def test_one_restart_masks_irq_releases_contacts_and_runs_without_io_lock(self): self.run_case('queue')
+    def test_stopping_does_not_queue_or_run_recovery(self): self.run_case('stopped')
+    def test_boot_failures_have_a_finite_retry_budget(self): self.run_case('bounded')
