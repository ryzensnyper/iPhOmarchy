				status = "disabled";
			};

			power-controller@80838 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80838 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "disp0_gp1";
				status = "disabled";
			};

			power-controller@80840 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80840 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "disp0_ppp";
				phandle = <0x4b>;
			};

			power-controller@80848 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80848 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "disp0_hilo";
				phandle = <0x4a>;
			};

			power-controller@84000 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x84000 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "isp_rsts0";
				power-domains = <0x32>;
			};

			power-controller@84008 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x84008 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "isp_rsts1";
				power-domains = <0x32>;
			};

			power-controller@84010 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x84010 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "isp_vis";
				power-domains = <0x32>;
			};

			power-controller@84018 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x84018 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "isp_be";
				power-domains = <0x32>;
			};

			power-controller@84020 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x84020 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "isp_pearl";
				power-domains = <0x32>;
			};

			power-controller@84028 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x84028 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "dprx";
				power-domains = <0x32>;
			};

			power-controller@84030 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x84030 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "isp_cnv";
				power-domains = <0x32>;
			};

			power-controller@88000 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x88000 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "venc_dma";
			};

			power-controller@88010 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x88010 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "venc_pipe4";
			};

			power-controller@88018 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x88018 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "venc_pipe5";
			};

			power-controller@88020 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x88020 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "venc_me0";
			};

			power-controller@88028 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x88028 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "venc_me1";
			};
		};

		backlight@232200080 {
			compatible = "apple,t8015-dwi-bl", "apple,dwi-bl";
			reg = <0x02 0x32200080 0x00 0x08>;
			power-domains = <0x33>;
			status = "okay";
		};

		pmp@232300000 {
			compatible = "apple,t8015-pmp-v1";
			reg = <0x02 0x32300000 0x00 0x8000 0x02 0x32400000 0x00 0x10000 0x02 0x32500000 0x00 0x20000>;
			reg-names = "akf", "control", "sram";
			mboxes = <0x34>;
			mbox-names = "mbox";
			power-domains = <0x35 0x36>;
			power-domain-names = "pmp", "sram";
			firmware-name = "apple/pmp-t8015.bin";
		};

		mbox@232308000 {
			compatible = "apple,t8015-asc-mailbox";
			reg = <0x02 0x32308000 0x00 0x4000>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0xe5 0x04 0x00 0xe6 0x04 0x00 0xe7 0x04 0x00 0xe8 0x04>;
			interrupt-names = "send-empty", "send-not-empty", "recv-empty", "recv-not-empty";
			#mbox-cells = <0x00>;
			power-domains = <0x35>;
			phandle = <0x34>;
		};

		pinctrl@233100000 {
			compatible = "apple,t8015-pinctrl", "apple,pinctrl";
			reg = <0x02 0x33100000 0x00 0x1000>;
			power-domains = <0x37>;
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0x18 0x00 0x00 0xdf>;
			apple,npins = <0xdf>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x32 0x04 0x00 0x33 0x04 0x00 0x34 0x04 0x00 0x35 0x04 0x00 0x36 0x04 0x00 0x37 0x04 0x00 0x38 0x04>;
			phandle = <0x18>;

			i2c0-pins {
				pinmux = <0x10049 0x10048>;
				phandle = <0x0f>;
			};

			i2c1-pins {
				pinmux = <0x100b6 0x100b5>;
				phandle = <0x11>;
			};

			i2c2-pins {
				pinmux = <0x10004 0x10003>;
				phandle = <0x13>;
			};

			i2c3-pins {
				pinmux = <0x100b8 0x100b7>;
				phandle = <0x15>;
			};

			wifi-clkreq-pins {
				pinmux = <0x100a3>;
				phandle = <0x52>;
			};
		};

		pinctrl@2340f0000 {
			compatible = "apple,t8015-pinctrl", "apple,pinctrl";
			reg = <0x02 0x340f0000 0x00 0x4000>;
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0x38 0x00 0x00 0x31>;
			apple,npins = <0x31>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x87 0x04 0x00 0x88 0x04 0x00 0x89 0x04 0x00 0x8a 0x04 0x00 0x8b 0x04 0x00 0x8c 0x04 0x00 0x8d 0x04>;
			phandle = <0x38>;
		};

		spmi@235180700 {
			compatible = "apple,t8015-spmi", "apple,t8103-spmi";
			reg = <0x02 0x35180700 0x00 0x100>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;

			pmic@f {
				compatible = "apple,agnes-pmic", "apple,spmi-pmic";
				reg = <0x0f 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x01>;

				rtc@1400 {
					compatible = "apple,agnes-pmic-rtc", "apple,antigua-pmic-rtc";
					reg = <0x1400 0x10>;
					nvmem-cells = <0x39>;
					nvmem-cell-names = "rtc_offset";
				};

				nvmem@6000 {
					compatible = "apple,pmic-nvmem";
					reg = <0x6000 0x300>;

					nvmem-layout {
						compatible = "fixed-layout";
						#address-cells = <0x01>;
						#size-cells = <0x01>;

						boot-stage@1 {
							reg = <0x01 0x01>;
							phandle = <0x42>;
						};

						boot-error-count@2,0 {
							reg = <0x02 0x01>;
							bits = <0x00 0x04>;
							phandle = <0x43>;
						};

						panic-count@2,4 {
							reg = <0x02 0x01>;
							bits = <0x04 0x04>;
							phandle = <0x44>;
						};

						boot-error-stage@3 {
							reg = <0x03 0x01>;
						};

						rtc-offset@4 {
							reg = <0x04 0x04>;
							phandle = <0x39>;
						};

						shutdown-flag@f {
							reg = <0x0f 0x01>;
							phandle = <0x41>;
						};
					};
				};
			};
		};

		pinctrl@2351f0000 {
			compatible = "apple,t8015-pinctrl", "apple,pinctrl";
			reg = <0x02 0x351f0000 0x00 0x4000>;
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0x3a 0x00 0x00 0x08>;
			apple,npins = <0x08>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0xa8 0x04 0x00 0xa9 0x04 0x00 0xaa 0x04>;
			phandle = <0x3a>;
		};

		power-management@235200000 {
			compatible = "apple,t8015-pmgr", "apple,pmgr", "syscon", "simple-mfd";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			reg = <0x02 0x35200000 0x00 0x84000>;

			power-controller@80008 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80008 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "aop_base";
				power-domains = <0x3b 0x3c>;
				apple,always-on;
			};

			power-controller@80050 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80050 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "debug";
			};

			power-controller@80020 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80020 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "aop_cpu";
				phandle = <0x3b>;
			};

			power-controller@80000 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80000 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "aop_filter";
				phandle = <0x3c>;
			};

			power-controller@80058 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80058 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "spmi";
				apple,always-on;
			};

			power-controller@800a8 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x800a8 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "smc_i2cm1";
				phandle = <0x3e>;
			};

			power-controller@80030 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80030 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "smc_fabric";
				phandle = <0x3d>;
			};

			power-controller@80140 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80140 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "smc_cpu";
				power-domains = <0x3d 0x3e>;
				phandle = <0x40>;
			};
		};

		watchdog@2352b0000 {
			compatible = "apple,t8015-wdt", "apple,wdt";
			reg = <0x02 0x352b0000 0x00 0x4000>;
			clocks = <0x0e>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0xac 0x04>;
		};

		smc@236000100 {
			compatible = "apple,t8015-smc", "apple,t8103-smc";
			reg = <0x02 0x36000100 0x00 0x100 0x02 0x36e00000 0x00 0x40000>;
			reg-names = "smc", "sram";
			mboxes = <0x3f>;
			power-domains = <0x40>;

			smc_gpio: gpio {
				compatible = "apple,smc-gpio";
				gpio-controller;
				#gpio-cells = <0x02>;
				phandle = <0x50>;
			};

			hwmon {
				compatible = "apple,smc-hwmon";

				temperature-TG0B {
					apple,key-id = "TG0B";
					label = "Battery Temp";
				};

				temperature-TG0V {
					apple,key-id = "TG0V";
					label = "Battery Flex Temp";
				};

				temperature-TP1d {
					apple,key-id = "TP1d";
					label = "Forehead Temp";
				};

				temperature-TP2d {
					apple,key-id = "TP2d";
					label = "Rear Camera Temp";
				};

				temperature-TP3d {
					apple,key-id = "TP3d";
					label = "Cellular Radio Temp";
				};

				temperature-TP4d {
					apple,key-id = "TP4d";
					label = "AP SoC Temp";
				};

				temperature-TP5d {
					apple,key-id = "TP5d";
					label = "Charger Temp";
				};
			};

			reboot {
				compatible = "apple,t8015-smc-reboot";
				nvmem-cells = <0x41 0x42 0x43 0x44>;
				nvmem-cell-names = "shutdown_flag", "boot_stage", "boot_error_count", "panic_count";
			};
		};

		pinctrl@236024000 {
			compatible = "apple,t8015-pinctrl", "apple,pinctrl";
			reg = <0x02 0x36024000 0x00 0x4000>;
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0x45 0x00 0x00 0x06>;
			apple,npins = <0x06>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0xc7 0x04 0x00 0xc8 0x04 0x00 0xc9 0x04 0x00 0xca 0x04 0x00 0xcb 0x04 0x00 0xcc 0x04 0x00 0xcd 0x04>;
			phandle = <0x45>;
		};

		mbox@236808000 {
			compatible = "apple,t8015-asc-mailbox";
			reg = <0x02 0x36808000 0x00 0x4000>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0xd1 0x04 0x00 0xd2 0x04 0x00 0xd3 0x04 0x00 0xd4 0x04>;
			interrupt-names = "send-empty", "send-not-empty", "recv-empty", "recv-not-empty";
			#mbox-cells = <0x00>;
			phandle = <0x3f>;
		};

		mbox@257008000 {
			compatible = "apple,t8015-asc-mailbox";
			reg = <0x02 0x57008000 0x00 0x4000>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x109 0x04 0x00 0x10a 0x04 0x00 0x10b 0x04 0x00 0x10c 0x04>;
			interrupt-names = "send-empty", "send-not-empty", "recv-empty", "recv-not-empty";
			#mbox-cells = <0x00>;
			power-domains = <0x46>;
			phandle = <0x47>;
		};

		iommu@259c50000 {
			compatible = "apple,t8015-sart";
			reg = <0x02 0x59c50000 0x00 0x10000>;
			power-domains = <0x46>;
			phandle = <0x48>;
		};

		nvme@259cc0000 {
			compatible = "apple,t8015-nvme-ans2";
			reg = <0x02 0x59cc0000 0x00 0x40000 0x02 0x59d20000 0x00 0x2000>;
			reg-names = "nvme", "ans";
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x10e 0x04>;
			mboxes = <0x47>;
			apple,sart = <0x48>;
			power-domains = <0x46 0x1c>;
			power-domain-names = "ans", "apcie0";
			resets = <0x46>;
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0x01>;
		interrupt-names = "phys", "virt";
		interrupts = <0x01 0x02 0x04 0x01 0x03 0x04>;
	};

	pmu-e {
		compatible = "apple,mistral-pmu";
		interrupt-parent = <0x01>;
		interrupts = <0x01 0x04 0x04>;
	};

	pmu-p {
		compatible = "apple,monsoon-pmu";
		interrupt-parent = <0x01>;
		interrupts = <0x01 0x05 0x04>;
	};

	aliases {
		ausbphy0 = "/soc/bus@230000000/phy@230000060";
		serial0 = "/soc/serial@22e600000";
		smc = "/soc/smc@236000100";
	};

	wlan_vdd: regulator-wlan-vdd {
		compatible = "regulator-fixed";
		regulator-name = "wlan-vdd";
		gpio = <0x50 0x0e 0x00>;
		enable-active-high;
		off-on-delay-us = <2500>;
		phandle = <0x51>;
	};

	chosen {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		stdout-path = "serial0";

		framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0x00 0x00 0x00 0x00>;
			power-domains = <0x2c 0x49 0x4a 0x4b>;
			status = "disabled";
		};
	};

	memory@800000000 {
		device_type = "memory";
		reg = <0x08 0x00 0x00 0x00>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
	};
};
