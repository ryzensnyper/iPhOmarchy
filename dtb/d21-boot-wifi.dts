/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	chassis-type = "handset";
	compatible = "apple,d21", "apple,t8015", "apple,arm-platform";
	model = "Apple iPhone 8 Plus (Global)";

	clock-ref {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x16e3600>;
		clock-output-names = "clkref";
		phandle = <0x0e>;
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x02>;
				};

				core1 {
					cpu = <0x03>;
				};

				core2 {
					cpu = <0x04>;
				};

				core3 {
					cpu = <0x05>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x06>;
				};

				core1 {
					cpu = <0x07>;
				};
			};
		};

		cpu@0 {
			compatible = "apple,mistral";
			reg = <0x00 0x00>;
			cpu-release-addr = <0x00 0x00>;
			performance-domains = <0x08>;
			operating-points-v2 = <0x09>;
			capacity-dmips-mhz = <0x279>;
			enable-method = "spin-table";
			device_type = "cpu";
			next-level-cache = <0x0a>;
			i-cache-size = <0x8000>;
			d-cache-size = <0x8000>;
			phandle = <0x02>;
		};

		cpu@1 {
			compatible = "apple,mistral";
			reg = <0x00 0x01>;
			cpu-release-addr = <0x00 0x00>;
			performance-domains = <0x08>;
			operating-points-v2 = <0x09>;
			capacity-dmips-mhz = <0x279>;
			enable-method = "spin-table";
			device_type = "cpu";
			next-level-cache = <0x0a>;
			i-cache-size = <0x8000>;
			d-cache-size = <0x8000>;
			phandle = <0x03>;
		};

		cpu@2 {
			compatible = "apple,mistral";
			reg = <0x00 0x02>;
			cpu-release-addr = <0x00 0x00>;
			performance-domains = <0x08>;
			operating-points-v2 = <0x09>;
			capacity-dmips-mhz = <0x279>;
			enable-method = "spin-table";
			device_type = "cpu";
			next-level-cache = <0x0a>;
			i-cache-size = <0x8000>;
			d-cache-size = <0x8000>;
			phandle = <0x04>;
		};

		cpu@3 {
			compatible = "apple,mistral";
			reg = <0x00 0x03>;
			cpu-release-addr = <0x00 0x00>;
			performance-domains = <0x08>;
			operating-points-v2 = <0x09>;
			capacity-dmips-mhz = <0x279>;
			enable-method = "spin-table";
			device_type = "cpu";
			next-level-cache = <0x0a>;
			i-cache-size = <0x8000>;
			d-cache-size = <0x8000>;
			phandle = <0x05>;
		};

		cpu@10004 {
			compatible = "apple,monsoon";
			reg = <0x00 0x10004>;
			cpu-release-addr = <0x00 0x00>;
			performance-domains = <0x0b>;
			operating-points-v2 = <0x0c>;
			capacity-dmips-mhz = <0x400>;
			enable-method = "spin-table";
			device_type = "cpu";
			next-level-cache = <0x0d>;
			i-cache-size = <0x10000>;
			d-cache-size = <0x10000>;
			phandle = <0x06>;
		};

		cpu@10005 {
			compatible = "apple,monsoon";
			reg = <0x00 0x10005>;
			cpu-release-addr = <0x00 0x00>;
			performance-domains = <0x0b>;
			operating-points-v2 = <0x0c>;
			capacity-dmips-mhz = <0x400>;
			enable-method = "spin-table";
			device_type = "cpu";
			next-level-cache = <0x0d>;
			i-cache-size = <0x10000>;
			d-cache-size = <0x10000>;
			phandle = <0x07>;
		};

		l2-cache-0 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			cache-size = <0x100000>;
			phandle = <0x0a>;
		};

		l2-cache-1 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			cache-size = <0x800000>;
			phandle = <0x0d>;
		};
	};

	opp-table-0 {
		compatible = "operating-points-v2";
		phandle = <0x09>;

		opp01 {
			opp-hz = <0x00 0x11e1a300>;
			opp-level = <0x01>;
			clock-latency-ns = <0x708>;
		};

		opp02 {
			opp-hz = <0x00 0x1b003b40>;
			opp-level = <0x02>;
			clock-latency-ns = <0x222e0>;
		};

		opp03 {
			opp-hz = <0x00 0x280de800>;
			opp-level = <0x03>;
			clock-latency-ns = <0x19a28>;
		};

		opp04 {
			opp-hz = <0x00 0x39ef8b00>;
			opp-level = <0x04>;
			clock-latency-ns = <0x1c138>;
		};

		opp05 {
			opp-hz = <0x00 0x4bd12e00>;
			opp-level = <0x05>;
			clock-latency-ns = <0x1e848>;
		};

		opp06 {
			opp-hz = <0x00 0x5db2d100>;
			opp-level = <0x06>;
			clock-latency-ns = <0x20f58>;
		};
	};

	opp-table-1 {
		compatible = "operating-points-v2";
		phandle = <0x0c>;

		opp01 {
			opp-hz = <0x00 0x11e1a300>;
			opp-level = <0x01>;
			clock-latency-ns = <0x578>;
		};

		opp02 {
			opp-hz = <0x00 0x1b003b40>;
			opp-level = <0x02>;
			clock-latency-ns = <0x222e0>;
		};

		opp03 {
			opp-hz = <0x00 0x32d7bf40>;
			opp-level = <0x03>;
			clock-latency-ns = <0x1adb0>;
		};

		opp04 {
			opp-hz = <0x00 0x4f64b500>;
			opp-level = <0x04>;
			clock-latency-ns = <0x1adb0>;
		};

		opp05 {
			opp-hz = <0x00 0x6c00ed00>;
			opp-level = <0x05>;
			clock-latency-ns = <0x1e848>;
		};

		opp06 {
			opp-hz = <0x00 0x7b062400>;
			opp-level = <0x06>;
			clock-latency-ns = <0x1fbd0>;
		};

		opp07 {
			opp-hz = <0x00 0x89544000>;
			opp-level = <0x07>;
			clock-latency-ns = <0x222e0>;
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		nonposted-mmio;
		ranges;

		performance-controller@208e20000 {
			compatible = "apple,t8015-cluster-cpufreq", "apple,t8103-cluster-cpufreq", "apple,cluster-cpufreq";
			reg = <0x02 0x8e20000 0x00 0x1000>;
			#performance-domain-cells = <0x00>;
			phandle = <0x08>;
		};

		performance-controller@208ea0000 {
			compatible = "apple,t8015-cluster-cpufreq", "apple,t8103-cluster-cpufreq", "apple,cluster-cpufreq";
			reg = <0x02 0x8ea0000 0x00 0x1000>;
			#performance-domain-cells = <0x00>;
			phandle = <0x0b>;
		};

		i2c@22e200000 {
			compatible = "apple,t8015-i2c", "apple,i2c";
			reg = <0x02 0x2e200000 0x00 0x1000>;
			clocks = <0x0e>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x130 0x04>;
			pinctrl-0 = <0x0f>;
			pinctrl-names = "default";
			power-domains = <0x10>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";

			pmic@27 {
				compatible = "apple,chestnut-pmic";
				reg = <0x27>;

				regulator-touch-hv {
					compatible = "apple,chestnut-touch-hv-regulator";
					phandle = <0x1a>;
				};
			};
		};

		i2c@22e204000 {
			compatible = "apple,t8015-i2c", "apple,i2c";
			reg = <0x02 0x2e204000 0x00 0x1000>;
			clocks = <0x0e>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x131 0x04>;
			pinctrl-0 = <0x11>;
			pinctrl-names = "default";
			power-domains = <0x12>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "disabled";
		};

		i2c@22e208000 {
			compatible = "apple,t8015-i2c", "apple,i2c";
			reg = <0x02 0x2e208000 0x00 0x1000>;
			clocks = <0x0e>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x132 0x04>;
			pinctrl-0 = <0x13>;
			pinctrl-names = "default";
			power-domains = <0x14>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "disabled";
		};

		i2c@22e20c000 {
			compatible = "apple,t8015-i2c", "apple,i2c";
			reg = <0x02 0x2e20c000 0x00 0x1000>;
			clocks = <0x0e>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x133 0x04>;
			pinctrl-0 = <0x15>;
			pinctrl-names = "default";
			power-domains = <0x16>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "disabled";
		};

		spi@22e404000 {
			compatible = "apple,t8015-spi", "apple,spi";
			reg = <0x02 0x2e404000 0x00 0x4000>;
			clocks = <0x0e>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x124 0x04>;
			power-domains = <0x17>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";
			cs-gpios = <0x18 0x8a 0x01>;

			touchscreen@0 {
				compatible = "apple,d21-touchscreen";
				reg = <0x00>;
				spi-max-frequency = <0x2dc6c0>;
				spi-cpol;
				spi-cpha;
				apple,z2-no-init-ack;
				interrupts-extended = <0x18 0x66 0x08>;
				reset-gpios = <0x18 0x21 0x01>;
				clocks = <0x19>;
				firmware-name = "apple/dfrmtfw-d21-c1f5e-3.bin";
				touchscreen-size-x = <0x438>;
				touchscreen-size-y = <0x780>;
				hv-supply = <0x1a>;
			};
		};

		dma-controller@22ee00000 {
			compatible = "apple,t8015-sio";
			reg = <0x02 0x2ee00000 0x00 0x20000>;
			reg-names = "a7iop";
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x135 0x04 0x00 0x134 0x04 0x00 0x137 0x04 0x00 0x136 0x04>;
			power-domains = <0x1b>;
			firmware-name = "apple/t8015-smartio.bin";
			dma-channels = <0x40>;
			#dma-cells = <0x01>;
			status = "disabled";
		};

		iommu@603008000 {
			compatible = "apple,t8015-dart", "apple,s5l8960x-dart";
			reg = <0x06 0x3008000 0x00 0x4000>;
			#iommu-cells = <0x01>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x15b 0x04>;
			power-domains = <0x1c>;
			apple,dma-range = <0x00 0x80000000 0x00 0x3ffff000>;
			status = "disabled";
		};

		iommu@604008000 {
			compatible = "apple,t8015-dart", "apple,s5l8960x-dart";
			reg = <0x06 0x4008000 0x00 0x4000>;
			#iommu-cells = <0x01>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x15e 0x04>;
			power-domains = <0x1c>;
			apple,dma-range = <0x00 0x80000000 0x00 0x3ffff000>;
			status = "okay";
			phandle = <0x1e>;
		};

		pcie@610000000 {
			compatible = "apple,t8015-pcie";
			device_type = "pci";
			reg = <0x06 0x10000000 0x00 0x1000000 0x06 0x00 0x00 0x50000 0x06 0x80000 0x00 0x4000 0x06 0xc0000 0x00 0x40000 0x06 0x1000000 0x00 0x4000 0x06 0x2000000 0x00 0x4000 0x06 0x3000000 0x00 0x4000 0x06 0x4000000 0x00 0x4000 0x06 0x1004000 0x00 0x4000>;
			reg-names = "config", "rc", "phy", "phy-ip", "port0", "port1", "port2", "port3", "nvmmu";
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x154 0x04 0x00 0x157 0x04 0x00 0x15a 0x04 0x00 0x15d 0x04>;
			interrupt-names = "port0", "port1", "port2", "port3";
			msi-controller;
			msi-parent = <0x1d>;
			msi-ranges = <0x01 0x00 0x160 0x01 0x20>;
			apple,msi-doorbell = <0xbffff000>;
			#address-cells = <0x03>;
			#size-cells = <0x02>;
			#interrupt-cells = <0x01>;
			interrupt-controller;
			bus-range = <0x00 0x0f>;
			ranges = <0x2000000 0x00 0x40000000 0x06 0x40000000 0x00 0x40000000 0x43000000 0x06 0x20000000 0x06 0x20000000 0x00 0x20000000>;
			power-domains = <0x1c>;
			iommu-map = <0x100 0x1e 0x00 0x01>;
			iommu-map-mask = <0xff00>;
			status = "okay";
			phandle = <0x1d>;

			pci@3,0 {
				device_type = "pci";
				reg = <0x1800 0x00 0x00 0x00 0x00>;
				bus-range = <0x01 0x01>;
				reset-gpios = <0x18 0xa7 0x01>;
				clkreq-gpios = <0x18 0xa3 0x01>;
				max-link-speed = <0x02>;
				apple,manual-availability-iommu = <0x1e 0x00>;
				apple,endpoint-cold-boot;
				#address-cells = <0x03>;
				#size-cells = <0x02>;
				ranges;

				wifi@0,0 {
					compatible = "apple,d21-bcm4357-wifi", "pci14e4,440a";
					reg = <0x10000 0x00 0x00 0x00 0x00>;
					device-wake-gpios = <0x18 0x28 0x00>;
					vdd-supply = <0x51>;
				};
			};
		};

		serial@22e600000 {
			compatible = "apple,s5l-uart";
			reg = <0x02 0x2e600000 0x00 0x4000>;
			reg-io-width = <0x04>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x11a 0x04>;
			clocks = <0x0e 0x0e>;
			clock-names = "uart", "clk_uart_baud0";
			power-domains = <0x1f>;
			status = "okay";
		};

		serial@22e604000 {
			compatible = "apple,s5l-uart";
			reg = <0x02 0x2e604000 0x00 0x4000>;
			reg-io-width = <0x04>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x11b 0x04>;
			clocks = <0x0e 0x0e>;
			clock-names = "uart", "clk_uart_baud0";
			power-domains = <0x20>;
			status = "okay";
		};

		bus@230000000 {
			compatible = "apple,t8015-usb-complex", "simple-pm-bus";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			dma-ranges = <0x00 0x00 0x08 0x00 0x01 0x00>;
			ranges;
			reg = <0x02 0x30000000 0x00 0x60>;
			power-domains = <0x21>;

			phy@230000060 {
				compatible = "apple,t8015-ausb-phy", "apple,ausb-phy";
				reg = <0x02 0x30000060 0x00 0x20>;
				power-domains = <0x22>;
				#phy-cells = <0x01>;
				phandle = <0x23>;
			};

			usbdev@230100000 {
				compatible = "apple,t8015-dwc2", "apple,dwc2";
				reg = <0x02 0x30100000 0x00 0x10000>;
				interrupts = <0x00 0x144 0x04>;
				clocks = <0x0e>;
				clock-names = "otg";
				phys = <0x23 0x03>;
				phy-names = "usb2-phy";
				power-domains = <0x24>;
				resets = <0x24>;
				dr_mode = "peripheral";
			};
		};

		interrupt-controller@232100000 {
			compatible = "apple,t8015-aic", "apple,aic";
			reg = <0x02 0x32100000 0x00 0x8000>;
			#interrupt-cells = <0x03>;
			interrupt-controller;
			power-domains = <0x25>;
			phandle = <0x01>;

			affinities {

				e-core-pmu-affinity {
					apple,fiq-index = <0x04>;
					cpus = <0x02 0x03 0x04 0x05>;
				};

				p-core-pmu-affinity {
					apple,fiq-index = <0x05>;
					cpus = <0x06 0x07>;
				};
			};
		};

		power-management@232000000 {
			compatible = "apple,t8015-pmgr", "apple,pmgr", "syscon", "simple-mfd";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			reg = <0x02 0x32000000 0x00 0x8c000>;

			clock-controller@78000 {
				compatible = "apple,t8015-touch-clock";
				reg = <0x78000 0x08>;
				#clock-cells = <0x00>;
				clocks = <0x0e>;
				clock-output-names = "touchclk";
				clock-frequency = <0x16e3600>;
				phandle = <0x19>;
			};

			power-controller@80000 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80000 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "cpu0";
				apple,always-on;
			};

			power-controller@80008 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80008 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "cpu1";
				apple,always-on;
			};

			power-controller@80010 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80010 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "cpu2";
				apple,always-on;
			};

			power-controller@80018 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80018 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "cpu3";
				apple,always-on;
			};

			power-controller@80020 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80020 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "cpu4";
				apple,always-on;
			};

			power-controller@80028 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80028 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "cpu5";
				apple,always-on;
			};

			power-controller@80040 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80040 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "cpm";
				apple,always-on;
			};

			power-controller@80158 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80158 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "sio_busif";
				phandle = <0x26>;
			};

			power-controller@80160 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80160 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "sio_p";
				power-domains = <0x26>;
				phandle = <0x27>;
			};

			power-controller@80100 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80100 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "sbr";
				apple,always-on;
			};

			power-controller@80108 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80108 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "aic";
				apple,always-on;
				phandle = <0x25>;
			};

			power-controller@80110 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80110 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "dwi";
				phandle = <0x33>;
			};

			power-controller@80118 {
				compatible = "apple,t8015-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80118 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "gpio";
				phandle = <0x37>;
