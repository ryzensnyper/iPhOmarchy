From 31f60476d81e5229aef093bb746c7a9b25c823a5 Mon Sep 17 00:00:00 2001
From: dugs <dugahol@protonmail.com>
Date: Thu, 29 Oct 2026 06:44:52 +1030
Subject: [PATCH 10/19] input: apple-z2: D21 raw feature-space probe, write=
 before probe_id

Add probe_raw/probe_len to read a report id without the
GET_REPORT_INFO gate: the property reports iOS reads after open
(0xd1/0xd3/0xd0/0xa1/0x7f) live in the feature namespace, which
GET_REPORT_INFO does not describe, so they need direct reads with an
explicit length. Also run the write= knob before the probe_id block so
a write can set up what a raw probe then reads (e.g. the report-0x01
feature-info select: write=1:01d3 then probe_id=1 probe_raw=1).
---
 drivers/input/touchscreen/apple_z2.c | 125 ++++++++++++++++-----------
 1 file changed, 76 insertions(+), 49 deletions(-)

diff --git a/drivers/input/touchscreen/apple_z2.c b/drivers/input/touchscreen/apple_z2.c
index a2ffd3aae..fe394fc3b 100644
--- a/drivers/input/touchscreen/apple_z2.c
+++ b/drivers/input/touchscreen/apple_z2.c
@@ -2287,6 +2287,15 @@ MODULE_PARM_DESC(probe_id, "Read this report id repeatedly after init (diagnosti
 static int d21_probe_times = 20;
 module_param_named(probe_times, d21_probe_times, int, 0444);
 MODULE_PARM_DESC(probe_times, "How many times to read probe_id");
+static bool d21_probe_raw;
+module_param_named(probe_raw, d21_probe_raw, bool, 0444);
+MODULE_PARM_DESC(probe_raw,
+		 "Read probe_id without the GET_REPORT_INFO gate, using probe_len bytes "
+		 "(the feature-property reports 0xd1/0xd3/0xd0/0xa1/0x7f answer in the "
+		 "feature space and are invisible to GET_REPORT_INFO)");
+static int d21_probe_len;
+module_param_named(probe_len, d21_probe_len, int, 0444);
+MODULE_PARM_DESC(probe_len, "Raw-read length for probe_raw (e.g. 8 for the 0x01 info reply)");
 static bool d21_poll;
 module_param_named(poll, d21_poll, bool, 0444);
 MODULE_PARM_DESC(poll, "Poll the interrupt-data queue after init (probe_times x 100 ms)");
@@ -2363,6 +2372,23 @@ static void apple_z2_d21_probe_report(struct apple_z2 *z2, u8 report,
 	u16 len = 0;
 	int error;
 
+	if (d21_probe_raw && d21_probe_id == report && d21_probe_len > 0) {
+		/*
+		 * Raw feature-space read: skip GET_REPORT_INFO entirely and
+		 * ask for probe_len bytes - the property reports live in the
+		 * feature namespace, which GET_REPORT_INFO does not describe.
+		 */
+		error = apple_z2_read_report_locked(z2, report, d21_probe_len,
+						    tag);
+		dev_info(dev, "D21 probe %s: raw read err=%d\n", tag, error);
+		if (error)
+			return;
+		dev_info(dev, "D21 probe %s: %*ph\n", tag,
+			 (int)min_t(size_t, d21_probe_len + 5U, 48U),
+			 z2->rx_buf);
+		return;
+	}
+
 	error = apple_z2_read_report_info_locked(z2, report, &status, &len, tag);
 	dev_info(dev, "D21 probe %s: info err=%d status=%u len=%u\n", tag,
 		 error, status, len);
@@ -2785,6 +2811,56 @@ static int apple_z2_d21_probe_tail(struct apple_z2 *z2)
 		apple_z2_d21_probe_report(z2, 0x72, "d21-72-state");
 	}
 
+	/*
+	 * Generic post-init report writes, applied after the whole init
+	 * choreography and with the IRQ already live - the position where the
+	 * iOS userspace arming lands (backboardd's MultitouchHID toggles a
+	 * one-byte "detection options" value and sends the touch mode only
+	 * once the device is open and on).  Each entry is id:hexpayload,
+	 * at most 11 payload bytes (CTRL_WRITE_SHORT), e.g.:
+	 *   insmod apple_z2.ko write=c8:01,c8:03
+	 */
+	if (d21_write && d21_write[0]) {
+		char *buf, *entry;
+
+		buf = kstrdup(d21_write, GFP_KERNEL);
+		if (!buf)
+			return -ENOMEM;
+		for (entry = buf; entry && *entry; ) {
+			u8 data[11];
+			unsigned int id, len = 0;
+			char *comma, *colon;
+
+			comma = strpbrk(entry, ",");
+			if (comma)
+				*comma++ = '\0';
+			colon = strchr(entry, ':');
+			if (!colon) {
+				dev_err(dev, "D21 write: bad entry '%s'\n",
+					entry);
+				entry = comma;
+				continue;
+			}
+			*colon++ = '\0';
+			id = simple_strtoul(entry, NULL, 16);
+			while (colon[0] && colon[1] && len < sizeof(data)) {
+				int hi = hex_to_bin(colon[0]);
+				int lo = hex_to_bin(colon[1]);
+
+				if (hi < 0 || lo < 0)
+					break;
+				data[len++] = (u8)((hi << 4) | lo);
+				colon += 2;
+			}
+			error = apple_z2_write_report_locked(z2, id, data, len,
+							     "d21-write");
+			dev_info(dev, "D21 write %02x len %u: err=%d\n",
+				 id, len, error);
+			entry = comma;
+		}
+		kfree(buf);
+	}
+
 	/*
 	 * Focused diagnostic: read one report id repeatedly so a counter report
 	 * (e.g. 0xf8) can be watched with and without a finger on the panel,
@@ -2867,55 +2943,6 @@ static int apple_z2_d21_probe_tail(struct apple_z2 *z2)
 		}
 	}
 
