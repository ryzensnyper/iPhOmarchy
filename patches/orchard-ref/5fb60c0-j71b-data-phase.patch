From 5fb60c0218486dbf40ac3f96b78de3c126154177 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Tue, 3 Nov 2026 04:28:19 +0800
Subject: [PATCH] Input: apple_z2: Read the frame a header in the J71b data
 phase announces

On the J71b each interrupt is served in two transfers: a header (0xe1
and the payload length), then the data phase that returns the frame.
When the data phase answers with a header instead (0xe1 0x56 0x00 ...,
86 bytes pending), the controller and the driver are a transfer apart.
The driver took that as a control reply and returned, the level
interrupt fired again, and every later read got a header back: touch
stayed dead, with the interrupt still firing, until the driver was
rebound (OrchardLinux/omarchy-a#25).

Take such a header as the next frame's and run the data phase for it,
once per read. On the J71b this happens about every ten seconds of use
and around session changes (74 times in three login rounds with heavy
swiping); touch no longer freezes.

Assisted-by: LLM
---
 drivers/input/touchscreen/apple_z2.c | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/drivers/input/touchscreen/apple_z2.c b/drivers/input/touchscreen/apple_z2.c
index 19d9f36faaad7d..f68295c76a218b 100644
--- a/drivers/input/touchscreen/apple_z2.c
+++ b/drivers/input/touchscreen/apple_z2.c
@@ -850,6 +850,7 @@ static int apple_z2_read_packet(struct apple_z2 *z2)
 {
 	struct spi_transfer xfer = { };
 	bool strict_counter;
+	bool resynced = false;
 	int error;
 	size_t pkt_len;
 	size_t wire_len;
@@ -891,6 +892,7 @@ static int apple_z2_read_packet(struct apple_z2 *z2)
 	}
 
 	payload_len = get_unaligned_le16(z2->rx_buf + 1);
+data_phase:
 	if (apple_z2_uses_gen1_data(z2) && !payload_len) {
 		z2->runtime_queue_empty = true;
 		if (apple_z2_is_n61(z2))
@@ -960,6 +962,22 @@ static int apple_z2_read_packet(struct apple_z2 *z2)
 	    (!z2->rx_buf[0] ||
 	     (wire_len >= 16 && z2->rx_buf[0] == APPLE_Z2_CMD_LAST &&
 	      apple_z2_z2_checksum_valid(z2->rx_buf, 16)))) {
+		/*
+		 * J71b: a header (interrupt data and its length) answering the
+		 * data phase means the controller and this driver are a transfer
+		 * apart. Ignored, every later read got a header back and touch
+		 * stayed dead until the controller was rebooted. Take it as the
+		 * next frame's header and read that frame.
+		 */
+		if (apple_z2_is_j71b(z2) && !resynced &&
+		    z2->rx_buf[0] == APPLE_Z2_REPLY_INTERRUPT_DATA) {
+			resynced = true;
+			payload_len = get_unaligned_le16(z2->rx_buf + 1);
+			dev_dbg(&z2->spidev->dev,
+				"header in the data phase (%u bytes pending): resynchronising\n",
+				payload_len);
+			goto data_phase;
+		}
 		z2->runtime_control_reply = true;
 		return 0;
 	}
