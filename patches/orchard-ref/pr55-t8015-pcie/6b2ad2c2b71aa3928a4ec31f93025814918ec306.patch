diff --git a/kernel/patches/devices/t8015/0006-arm64-dts-apple-t8015-Enable-PCIe-on-D221.patch b/kernel/patches/devices/t8015/0006-arm64-dts-apple-t8015-Enable-PCIe-on-D221.patch
